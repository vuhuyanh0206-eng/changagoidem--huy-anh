# ====== Cấu hình chung ======
PORT=3000
NODE_ENV=production
# Chuỗi bí mật ký cookie phiên đăng nhập (đặt chuỗi ngẫu nhiên dài, KHÔNG để mặc định)
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-that-dai
# Địa chỉ website (dùng cho SEO, sitemap, link chia sẻ)
SITE_URL=https://khodemhp.vn

# ====== Tài khoản admin khởi tạo (chỉ dùng lần chạy đầu tiên) ======
ADMIN_USER=admin
ADMIN_PASSWORD=DoiMatKhauNay@2026

# ====== Cơ sở dữ liệu MySQL (Hostinger > Databases > MySQL) ======
# Để trống DB_HOST thì website dùng SQLite (file data/khodem.db), chỉ nên dùng khi chạy thử trên máy
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_khodem
DB_USER=u123456789_khodem
DB_PASSWORD=mat-khau-database

