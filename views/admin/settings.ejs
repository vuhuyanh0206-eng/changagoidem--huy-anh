<%- include('_top') %>
<form method="post" action="/admin/settings" class="form-layout">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-main">
    <section class="panel">
      <h2>Thông tin cửa hàng</h2>
      <div class="row2">
        <label class="f"><span>Tên cửa hàng</span><input class="in" name="site_name" value="<%= s.site_name %>"></label>
        <label class="f"><span>Khẩu hiệu</span><input class="in" name="tagline" value="<%= s.tagline %>"></label>
        <label class="f"><span>Hotline chính</span><input class="in" name="hotline" value="<%= s.hotline %>"></label>
        <label class="f"><span>Hotline phụ</span><input class="in" name="hotline2" value="<%= s.hotline2 %>"></label>
        <label class="f"><span>Số Zalo (liền, không dấu cách)</span><input class="in" name="zalo" value="<%= s.zalo %>"></label>
        <label class="f"><span>Email</span><input class="in" name="email" value="<%= s.email %>"></label>
        <label class="f"><span>Website (tên miền)</span><input class="in" name="website" value="<%= s.website %>" placeholder="https://dem191.com"></label>
      </div>
      <label class="f"><span>Địa chỉ kho – showroom <small>(nhiều địa chỉ cách nhau bằng dấu |)</small></span><input class="in" name="address" value="<%= s.address %>"></label>
      <div class="row2">
        <label class="f"><span>Giờ mở cửa</span><input class="in" name="open_hours" value="<%= s.open_hours %>"></label>
        <label class="f"><span>Link Facebook</span><input class="in" name="facebook" value="<%= s.facebook %>" placeholder="https://facebook.com/khodemhp"></label>
      </div>
      <label class="f"><span>Link nhúng Google Maps <small>(Google Maps → Chia sẻ → Nhúng bản đồ → copy phần trong src="…")</small></span><input class="in" name="map_embed" value="<%= s.map_embed %>" placeholder="https://www.google.com/maps/embed?pb=..."></label>
    </section>
    <section class="panel">
      <h2>Thông tin doanh nghiệp (Bộ Công Thương)</h2>
      <p class="muted">Bắt buộc hiển thị ở chân trang và trong các chính sách khi thông báo website với Bộ Công Thương (online.gov.vn). Điền đúng như trên giấy đăng ký kinh doanh.</p>
      <div class="row2">
        <label class="f"><span>Tên hộ kinh doanh / công ty</span><input class="in" name="biz_name" value="<%= s.biz_name %>" placeholder="VD: Hộ kinh doanh Đệm 191"></label>
        <label class="f"><span>Người đại diện / chủ hộ</span><input class="in" name="biz_rep" value="<%= s.biz_rep %>"></label>
        <label class="f"><span>Số giấy chứng nhận ĐKKD</span><input class="in" name="biz_reg_no" value="<%= s.biz_reg_no %>"></label>
        <label class="f"><span>Mã số thuế</span><input class="in" name="biz_tax_code" value="<%= s.biz_tax_code %>"></label>
        <label class="f"><span>Ngày cấp</span><input class="in" name="biz_reg_date" value="<%= s.biz_reg_date %>" placeholder="dd/mm/yyyy"></label>
        <label class="f"><span>Nơi cấp</span><input class="in" name="biz_reg_place" value="<%= s.biz_reg_place %>" placeholder="VD: Phòng Tài chính – Kế hoạch quận Lê Chân"></label>
      </div>
      <label class="f"><span>Địa chỉ trụ sở <small>(để trống = địa chỉ cửa hàng đầu tiên)</small></span><input class="in" name="biz_address" value="<%= s.biz_address %>"></label>
      <div class="row2">
        <label class="f"><span>Số ngày đổi trả</span><input class="in" name="return_days" value="<%= s.return_days %>" inputmode="numeric"></label>
        <label class="f"><span>Link xác thực Bộ Công Thương <small>(dán sau khi được duyệt, logo tự hiện)</small></span><input class="in" name="bct_url" value="<%= s.bct_url %>" placeholder="http://online.gov.vn/Home/WebDetails/..."></label>
      </div>
    </section>
    <section class="panel">
      <h2>Giao hàng &amp; khuyến mãi</h2>
      <label class="f"><span>Dòng thông báo trên cùng</span><input class="in" name="free_ship_text" value="<%= s.free_ship_text %>"></label>
      <div class="row3">
        <label class="f"><span>Phí giao mặc định (₫, 0 = miễn phí)</span><input class="in" name="shipping_fee" value="<%= s.shipping_fee %>" inputmode="numeric"></label>
        <label class="f"><span>Miễn phí giao cho đơn từ (₫)</span><input class="in" name="free_ship_min" value="<%= s.free_ship_min %>" inputmode="numeric"></label>
        <label class="f"><span>Flash sale kết thúc lúc</span><input class="in" type="datetime-local" name="flash_sale_end" value="<%= s.flash_sale_end %>"></label>
      </div>
      <p class="muted">Để trống thời gian flash sale thì đồng hồ tự đếm đến 23:59 mỗi ngày.</p>
    </section>
    <section class="panel">
      <h2>Popup nhận voucher</h2>
      <p class="muted">Popup tự hiện sau vài giây với khách mới (mỗi khách tối đa 1 lần trong 3 ngày). Thông tin khách để lại nằm ở mục <b>Khách cần tư vấn</b>, nguồn “voucher”.</p>
      <div class="row3">
        <label class="f"><span>Trạng thái</span><select class="in" name="voucher_on"><option value="1"<%= s.voucher_on === '1' ? ' selected' : '' %>>Bật</option><option value="0"<%= s.voucher_on !== '1' ? ' selected' : '' %>>Tắt</option></select></label>
        <label class="f"><span>Giá trị voucher (chữ to)</span><input class="in" name="voucher_value" value="<%= s.voucher_value %>" placeholder="200.000đ"></label>
        <label class="f"><span>Tiêu đề</span><input class="in" name="voucher_title" value="<%= s.voucher_title %>"></label>
      </div>
      <label class="f"><span>Dòng mô tả</span><input class="in" name="voucher_sub" value="<%= s.voucher_sub %>"></label>
    </section>
    <section class="panel">
      <h2>Chuyển khoản (VietQR)</h2>
      <p class="muted">Khi khách chọn chuyển khoản, website tự tạo mã QR có sẵn số tiền và nội dung là mã đơn.</p>
      <div class="row3">
        <label class="f"><span>Mã ngân hàng</span><input class="in" name="bank_code" value="<%= s.bank_code %>" placeholder="VCB, MB, TCB, ACB…"></label>
        <label class="f"><span>Số tài khoản</span><input class="in" name="bank_account" value="<%= s.bank_account %>"></label>
        <label class="f"><span>Chủ tài khoản (viết hoa không dấu)</span><input class="in" name="bank_holder" value="<%= s.bank_holder %>"></label>
      </div>
    </section>
    <section class="panel">
      <h2>SEO &amp; theo dõi</h2>
      <label class="f"><span>Mô tả website (Google)</span><textarea class="in" name="meta_description" rows="3"><%= s.meta_description %></textarea></label>
      <div class="row2">
        <label class="f"><span>Google Analytics 4 (G-XXXXXXX)</span><input class="in" name="ga_id" value="<%= s.ga_id %>"></label>
        <label class="f"><span>Facebook Pixel ID</span><input class="in" name="fb_pixel" value="<%= s.fb_pixel %>"></label>
      </div>
    </section>
  </div>
  <aside class="form-side">
    <section class="panel"><h2>Lưu thay đổi</h2><button class="b b--primary b--block" type="submit">Lưu cài đặt</button></section>
  </aside>
</form>

<form method="post" action="/admin/password" class="panel" id="password" style="max-width:520px">
  <h2>Đổi mật khẩu quản trị</h2>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label class="f"><span>Mật khẩu hiện tại</span><input class="in" type="password" name="current" autocomplete="current-password" required></label>
  <label class="f"><span>Mật khẩu mới (tối thiểu 8 ký tự)</span><input class="in" type="password" name="next" autocomplete="new-password" minlength="8" required></label>
  <label class="f"><span>Nhập lại mật khẩu mới</span><input class="in" type="password" name="confirm" autocomplete="new-password" minlength="8" required></label>
  <button class="b b--primary" type="submit">Đổi mật khẩu</button>
</form>
<%- include('_bottom') %>
