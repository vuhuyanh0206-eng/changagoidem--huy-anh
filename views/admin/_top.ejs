<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · Quản trị <%= s.site_name %></title>
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css?v=1">
</head>
<body>
<%- include('../partials/icons') %>
<% const nav = [
  ['/admin', 'i-home', 'Tổng quan'],
  ['/admin/orders', 'i-cart', 'Đơn hàng', badge.orders],
  ['/admin/leads', 'i-phone', 'Khách cần tư vấn', badge.leads],
  ['/admin/products', 'i-grid', 'Sản phẩm'],
  ['/admin/categories', 'i-sliders', 'Danh mục'],
  ['/admin/banners', 'i-gift', 'Banner'],
  ['/admin/posts', 'i-news', 'Bài viết'],
  ['/admin/settings', 'i-award', 'Cài đặt'],
]; const cur = path.replace(/\/$/, '') || '/admin'; %>
<div class="adm">
  <aside class="adm__side" id="adm-side">
    <a class="adm__logo" href="/admin"><img src="/images/favicon.svg" alt="" width="34" height="34"><span><b><%= s.site_name %></b><small>Quản trị</small></span></a>
    <nav>
      <% nav.forEach(n => { const on = n[0] === '/admin' ? cur === '/admin' : cur.startsWith(n[0]); %>
        <a href="<%= n[0] %>" class="<%= on ? 'is-active' : '' %>"><svg class="i"><use href="#<%= n[1] %>"/></svg><span><%= n[2] %></span><% if (n[3]) { %><em><%= n[3] %></em><% } %></a>
      <% }) %>
    </nav>
    <div class="adm__side-foot">
      <a href="/" target="_blank" rel="noopener"><svg class="i"><use href="#i-arrow-r"/></svg>Xem website</a>
      <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><svg class="i"><use href="#i-x"/></svg>Đăng xuất (<%= admin.username %>)</button></form>
    </div>
  </aside>
  <div class="adm__main">
    <header class="adm__bar">
      <button class="adm__burger" type="button" onclick="document.getElementById('adm-side').classList.toggle('is-open')" aria-label="Menu"><svg class="i"><use href="#i-menu"/></svg></button>
      <h1><%= title %></h1>
    </header>
    <div class="adm__content">
      <% if (flash) { %><div class="alert alert--<%= flash.type %>" role="status"><%= flash.msg %></div><% } %>
