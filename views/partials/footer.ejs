<% const tel2 = (x) => String(x || '').replace(/[^\d+]/g, ''); %>
<section class="newsletter">
  <div class="container newsletter__inner">
    <div>
      <span class="eyebrow eyebrow--light">Tư vấn miễn phí 1:1</span>
      <h2 class="newsletter__title">Chưa biết chọn đệm nào? Để chuyên viên gọi lại cho bạn</h2>
      <p>Chỉ cần để lại số điện thoại, Đệm 191 sẽ gọi trong 15 phút (giờ hành chính).</p>
    </div>
    <form class="newsletter__form" method="post" action="/lien-he">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="source" value="footer-callback">
      <input type="hidden" name="back" value="<%= path %>">
      <label class="sr-only" for="nl-name">Họ tên</label>
      <input id="nl-name" name="name" placeholder="Họ tên" autocomplete="name">
      <label class="sr-only" for="nl-phone">Số điện thoại</label>
      <input id="nl-phone" name="phone" type="tel" placeholder="Số điện thoại *" required pattern="[0-9+ ]{9,15}" autocomplete="tel">
      <button class="btn btn--gold" type="submit">Gọi lại cho tôi</button>
      <label class="agree agree--light newsletter__agree"><input type="checkbox" name="agree" value="1" required><span>Tôi đồng ý để <%= s.site_name %> lưu và sử dụng thông tin trên để liên hệ tư vấn, theo <a href="/chinh-sach/bao-mat" target="_blank">Chính sách bảo mật</a>.</span></label>
    </form>
  </div>
</section>

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="logo logo--footer" aria-label="<%= s.site_name %>">
        <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true"><rect x="1" y="1" width="46" height="46" rx="12" fill="none" stroke="currentColor" stroke-opacity=".35"/><path d="M30.5 12.5a11 11 0 1 0 5 15.5 8.6 8.6 0 0 1-5-15.5z" fill="var(--gold-400)"/><path d="M9 33.5c4-2.2 9.6-3.3 15-3.3s11 1.1 15 3.3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        <span class="logo__text"><span class="logo__name">Đệm <b>191</b></span><span class="logo__sub">Sleep &amp; Bedding Store</span></span>
      </a>
      <p class="footer__about"><%= s.tagline %>. Cam kết hàng chính hãng, đầy đủ phiếu bảo hành của nhà sản xuất.</p>
      <ul class="footer__contact">
        <% String(s.address || '').split('|').map(x => x.trim()).filter(Boolean).forEach(a => { %><li><svg class="i"><use href="#i-pin"/></svg><span><%= a %></span></li><% }) %>
        <li><svg class="i"><use href="#i-phone"/></svg><span><a href="tel:<%= tel2(s.hotline) %>"><%= s.hotline %></a> – <a href="tel:<%= tel2(s.hotline2) %>"><%= s.hotline2 %></a> (Zalo)</span></li>
        <% if (s.email) { %><li><svg class="i"><use href="#i-mail"/></svg><a href="mailto:<%= s.email %>"><%= s.email %></a></li><% } %>
        <li><svg class="i"><use href="#i-clock"/></svg><span><%= s.open_hours %></span></li>
      </ul>
    </div>
    <div>
      <h3 class="footer__h">Sản phẩm</h3>
      <ul class="footer__links">
        <% menu.slice(0, 7).forEach(c => { %><li><a href="/danh-muc/<%= c.slug %>"><%= c.name %></a></li><% }) %>
      </ul>
    </div>
    <div>
      <h3 class="footer__h">Chính sách</h3>
      <ul class="footer__links">
        <li><a href="/chinh-sach/giao-hang">Giao hàng &amp; lắp đặt</a></li>
        <li><a href="/chinh-sach/doi-tra">Chính sách đổi trả</a></li>
        <li><a href="/chinh-sach/bao-hanh">Bảo hành</a></li>
        <li><a href="/chinh-sach/tra-gop">Trả góp 0%</a></li>
        <li><a href="/chinh-sach/bao-mat">Bảo mật thông tin</a></li>
        <li><a href="/chinh-sach/kiem-hang">Chính sách kiểm hàng</a></li>
        <li><a href="/chinh-sach/thanh-toan">Hình thức thanh toán</a></li>
        <li><a href="/chinh-sach/khieu-nai">Giải quyết khiếu nại</a></li>
        <li><a href="/chinh-sach/dieu-khoan">Điều khoản giao dịch</a></li>
      </ul>
    </div>
    <div>
      <h3 class="footer__h">Kết nối</h3>
      <div class="footer__social">
        <% if (s.facebook) { %><a href="<%= s.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><svg class="i"><use href="#i-fb"/></svg></a><% } %>
        <a href="https://zalo.me/<%= tel2(s.zalo) %>" target="_blank" rel="noopener" aria-label="Zalo" class="zalo-txt">Zalo</a>
        <a href="tel:<%= tel2(s.hotline) %>" aria-label="Gọi điện"><svg class="i"><use href="#i-phone"/></svg></a>
      </div>
      <h3 class="footer__h footer__h--sm">Thanh toán</h3>
      <div class="pay-badges"><span>COD</span><span>Chuyển khoản</span><span>VietQR</span><span>Trả góp 0%</span></div>
    </div>
  </div>
  <% const bizAddr = s.biz_address || String(s.address || '').split('|')[0].trim(); %>
  <div class="container footer__legal">
    <div class="footer__legal-txt">
      <p><b><%= s.biz_name || s.site_name %></b></p>
      <% if (s.biz_reg_no) { %><p>Giấy chứng nhận đăng ký kinh doanh số <%= s.biz_reg_no %><% if (s.biz_reg_date) { %> cấp ngày <%= s.biz_reg_date %><% } %><% if (s.biz_reg_place) { %> tại <%= s.biz_reg_place %><% } %>.</p><% } %>
      <% if (s.biz_tax_code) { %><p>Mã số thuế: <%= s.biz_tax_code %><% if (s.biz_rep) { %> · Người đại diện: <%= s.biz_rep %><% } %></p><% } else if (s.biz_rep) { %><p>Người đại diện: <%= s.biz_rep %></p><% } %>
      <p>Địa chỉ trụ sở: <%= bizAddr %> · Điện thoại: <%= s.hotline %><% if (s.email) { %> · Email: <%= s.email %><% } %><% if (s.website) { %> · Website: <a href="<%= s.website %>"><%= s.website.replace(/^https?:\/\//, '') %></a><% } %></p>
    </div>
    <% if (s.bct_url) { %><a class="footer__bct" href="<%= s.bct_url %>" target="_blank" rel="noopener" title="Đã thông báo Bộ Công Thương"><svg class="i" aria-hidden="true"><use href="#i-check"/></svg><span><small>Đã thông báo</small>Bộ Công Thương</span></a><% } %>
  </div>
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <span>© <%= new Date().getFullYear() %> <%= s.site_name %>. Bảo lưu mọi quyền.</span>
      <span>Đệm cao su · Đệm lò xo · Đệm foam · Chăn ga gối</span>
    </div>
  </div>
</footer>

<!-- Nút liên hệ nổi -->
<div class="fab" aria-label="Liên hệ nhanh">
  <a class="fab__btn fab__btn--zalo" href="https://zalo.me/<%= tel2(s.zalo) %>" target="_blank" rel="noopener" aria-label="Chat Zalo"><span>Zalo</span></a>
  <a class="fab__btn fab__btn--call" href="tel:<%= tel2(s.hotline) %>" aria-label="Gọi <%= s.hotline %>"><svg class="i"><use href="#i-phone"/></svg><span class="fab__ring"></span></a>
  <button class="fab__btn fab__btn--top" type="button" data-to-top aria-label="Lên đầu trang" hidden><svg class="i"><use href="#i-up"/></svg></button>
</div>

<!-- Thanh điều hướng dưới cho mobile -->
<nav class="bottom-nav" aria-label="Điều hướng nhanh">
  <a href="/" class="<%= path === '/' ? 'is-active' : '' %>"><svg class="i"><use href="#i-home"/></svg><span>Trang chủ</span></a>
  <button type="button" data-open="drawer-menu"><svg class="i"><use href="#i-grid"/></svg><span>Danh mục</span></button>
  <a href="tel:<%= tel2(s.hotline) %>" class="bottom-nav__call"><svg class="i"><use href="#i-phone"/></svg><span>Gọi ngay</span></a>
  <a href="https://zalo.me/<%= tel2(s.zalo) %>" target="_blank" rel="noopener"><span class="bn-zalo">Zalo</span><span>Chat</span></a>
  <% if (s.cart_on === '1') { %><a href="/gio-hang" data-open="drawer-cart"><span class="cart-ico"><svg class="i"><use href="#i-cart"/></svg><em class="cart-count" data-cart-count>0</em></span><span>Giỏ hàng</span></a><% } else { %><a href="/lien-he" class="<%= path === '/lien-he' ? 'is-active' : '' %>"><svg class="i"><use href="#i-pin"/></svg><span>Liên hệ</span></a><% } %>
</nav>

<% if (s.voucher_on === '1' && !/^\/(gio-hang|thanh-toan|dat-hang)/.test(path)) { %>
<div class="vpop" data-vpop hidden>
  <div class="vpop__backdrop" data-vpop-close></div>
  <div class="vpop__wrap" role="dialog" aria-modal="true" aria-labelledby="vpop-title">
    <button class="vpop__x" type="button" data-vpop-close aria-label="Đóng"><svg class="i"><use href="#i-x"/></svg></button>
    <div class="vpop__poster">
      <span class="vpop__burst" aria-hidden="true"></span>
      <span class="vpop__logo"><svg class="i"><use href="#i-moon"/></svg><%= s.site_name %></span>
      <p class="vpop__ribbon"><span>Voucher online</span></p>
      <strong class="vpop__value"><%= s.voucher_value %></strong>
      <p class="vpop__for" id="vpop-title"><%= s.voucher_title %></p>
      <ul class="vpop__lines" aria-label="Áp dụng cho">
        <li><svg class="i"><use href="#i-leaf"/></svg>Đệm cao su</li>
        <li><svg class="i"><use href="#i-spine"/></svg>Đệm lò xo</li>
        <li><svg class="i"><use href="#i-moon"/></svg>Đệm foam</li>
        <li><svg class="i"><use href="#i-snow"/></svg>Chăn ga gối</li>
      </ul>
      <img class="vpop__stack" src="/images/promo/chong-dem.png" alt="" width="600" height="403">
      <span class="vpop__seal" aria-hidden="true"><b>Chính</b>hãng</span>
      <div class="vpop__strip">
        <span><svg class="i"><use href="#i-cart"/></svg>Đăng ký <b>online</b></span>
        <span><svg class="i"><use href="#i-headset"/></svg>Tư vấn <b>miễn phí 1:1</b></span>
      </div>
    </div>
    <form class="vpop__form" method="post" action="/lien-he" data-vpop-form>
      <p class="vpop__sub"><%= s.voucher_sub %></p>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="source" value="voucher">
      <input type="hidden" name="message" value="Nhận voucher <%= s.voucher_value %>">
      <input type="hidden" name="back" value="<%= path %>">
      <label class="sr-only" for="vp-name">Họ tên</label>
      <input id="vp-name" name="name" placeholder="Họ tên *" required maxlength="80" autocomplete="name">
      <label class="sr-only" for="vp-phone">Số điện thoại</label>
      <input id="vp-phone" name="phone" placeholder="Số điện thoại *" required inputmode="tel" pattern="[0-9 +.]{9,15}" maxlength="15" autocomplete="tel">
      <label class="sr-only" for="vp-email">Email</label>
      <input id="vp-email" name="email" type="email" placeholder="Email (nếu có)" maxlength="120" autocomplete="email">
      <label class="agree agree--light"><input type="checkbox" name="agree" value="1" required><span>Tôi đồng ý với <a href="/chinh-sach/bao-mat" target="_blank">Chính sách bảo mật</a> của <%= s.site_name %>.</span></label>
      <button class="vpop__btn" type="submit">Nhận ngay</button>
    </form>
    <div class="vpop__done" data-vpop-done hidden>
      <svg class="i"><use href="#i-check"/></svg>
      <h2>Đăng ký thành công!</h2>
      <p><%= s.site_name %> sẽ liên hệ gửi voucher cho bạn sớm nhất. Cần gấp, gọi <a href="tel:<%= tel2(s.hotline) %>"><%= s.hotline %></a>.</p>
    </div>
  </div>
</div>
<% } %>

<div class="toast" role="status" aria-live="polite" data-toast hidden></div>
<script>window.KHP = { csrf: '<%= csrfToken %>' };</script>
<script src="/js/main.js?v=5" defer></script>
</body>
</html>
