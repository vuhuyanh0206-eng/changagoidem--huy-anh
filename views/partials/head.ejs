<%
  const m = typeof meta !== 'undefined' ? meta : {};
  const pageTitle = m.title || s.site_name;
  const rawDesc = String(m.description || s.meta_description || '').replace(/\s+/g, ' ').trim();
  // Google hiển thị khoảng 155–160 ký tự: cắt ở cuối một từ
  const pageDesc = rawDesc.length > 160 ? rawDesc.slice(0, 157).replace(/[\s,.;:–-]+\S*$/, '') + '…' : rawDesc;
  const ogImg = m.image ? (m.image.startsWith('http') ? m.image : siteUrl + m.image) : siteUrl + '/images/og-cover.jpg';
%><!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <% if (m.robots) { %><meta name="robots" content="<%= m.robots %>"><% } %>
  <link rel="canonical" href="<%= siteUrl + path %>">
  <meta property="og:type" content="<%= m.type || 'website' %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:image" content="<%= ogImg %>">
  <meta property="og:url" content="<%= siteUrl + path %>">
  <meta property="og:locale" content="vi_VN">
  <meta name="theme-color" content="#0F2A4D">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=3">
  <script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'FurnitureStore', name: s.site_name, url: siteUrl, telephone: s.hotline, address: String(s.address || '').split('|').map(x => x.trim()).filter(Boolean).join('; '), openingHours: s.open_hours, image: siteUrl + '/images/og-cover.jpg' }) %></script>
  <% if (s.ga_id) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= s.ga_id %>"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','<%= s.ga_id %>');</script>
  <% } %>
  <% if (s.fb_pixel) { %>
  <script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','<%= s.fb_pixel %>');fbq('track','PageView');</script>
  <% } %>
</head>
<body>
<%- include('icons') %>
<a class="skip-link" href="#main">Bỏ qua đến nội dung chính</a>
