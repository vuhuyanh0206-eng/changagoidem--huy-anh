<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@600;700;800&display=block" rel="stylesheet">
<style>
  /* Ảnh vuông 1080x1080 cho băng chuyền Facebook: nhãn in sẵn giống nhãn trên ảnh sản phẩm ở web */
  html, body { margin: 0; width: 1080px; height: 1080px; overflow: hidden; background: #fff; font-family: 'Inter', system-ui, sans-serif; }
  .frame { position: relative; width: 1080px; height: 1080px; }
  .frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lbl { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 40px; }
  .lbl::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,22,48,.55) 0%, rgba(10,22,48,0) 34%, rgba(10,22,48,0) 72%, rgba(10,22,48,.45) 100%); }
  .lbl > * { position: relative; }
  .top { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; text-align: right; margin-left: auto; max-width: 78%; }
  .type { background: #0f2a4d; color: #fff; font-size: 32px; font-weight: 600; line-height: 1; padding: 14px 22px; border-radius: 14px; }
  .model { color: #fff; font-weight: 800; font-size: 64px; line-height: 1.1; letter-spacing: .03em; text-transform: uppercase; text-shadow: 0 3px 10px rgba(0,0,0,.55); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .chips { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 14px; }
  .chip { background: #0f2a4d; color: #fff; font-size: 32px; font-weight: 600; line-height: 1; padding: 14px 24px; border-radius: 999px; white-space: nowrap; }
  .chip::before { content: "•"; margin-right: 10px; color: #d9a848; }
</style>
</head>
<body>
<div class="frame">
  <img src="<%= img %>" alt="">
  <div class="lbl">
    <div class="top">
      <span class="type"><%= L.type %></span>
      <span class="model"><%= L.model %></span>
    </div>
    <div class="chips">
      <span class="chip">Bảo hành: <%= L.warranty %></span>
      <% if (L.thickness) { %><span class="chip">Độ dày: <%= L.thickness %></span><% } %>
    </div>
  </div>
</div>
</body>
</html>
