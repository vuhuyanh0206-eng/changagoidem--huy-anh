<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/breadcrumb') %>
<% const tel = (x) => String(x || '').replace(/[^\d+]/g, ''); const defSize = product.defaultSize; const contact = !(product.finalPrice > 0);
  // Biến thể dạng "160 x 200 x 9 cm" → tách thành 2 bước: độ dày + kích thước
  const RE = /^(\d+) x (\d+) x (\d+(?:\.\d+)?) cm$/;
  const grouped = product.sizes.length > 1 && product.sizes.every(s => RE.test(s.label));
  const thicks = grouped ? [...new Set(product.sizes.map(s => +s.label.match(RE)[3]))].sort((a, b) => a - b) : [];
  const defThick = grouped ? +defSize.label.match(RE)[3] : null;
  const fpOf = (sz) => sz.sale_price > 0 && sz.sale_price < sz.price ? sz.sale_price : sz.price; %>
<main id="main" class="container">
  <div class="pd" data-product>
    <div class="gallery">
      <div class="gallery__main" data-gallery-main>
        <img src="<%= product.image %>" alt="<%= product.name %>" width="1300" height="975" fetchpriority="high">
        <%- include('../partials/img-label', { L: product.imgLabel, big: true }) %>
        <span class="pcard__tags">
          <% if (product.discount) { %><span class="tag tag--sale">-<%= product.discount %>%</span><% } %>
          <% if (product.badge) { %><span class="tag tag--gold"><%= product.badge %></span><% } %>
        </span>
      </div>
      <% if (product.images.length > 1) { %>
      <div class="gallery__thumbs">
        <% product.images.forEach((im, i) => { %>
          <button type="button" class="<%= i === 0 ? 'is-active' : '' %>" data-thumb="<%= im %>" aria-label="Ảnh <%= i + 1 %>"><img src="<%= im %>" alt="" loading="lazy" width="200" height="150"></button>
        <% }) %>
      </div>
      <% } %>
    </div>

    <div class="pd__info">
      <div class="pd__brand">
        <a href="/tim-kiem?q=<%= encodeURIComponent(product.brand || '') %>"><%= product.brand %></a>
        <span>Mã: <%= product.sku %></span>
        <span style="color:var(--ok);font-weight:600"><%= product.in_stock ? '● Còn hàng' : '○ Tạm hết hàng' %></span>
      </div>
      <h1><%= product.name %></h1>
      <% if (product.rating_count || product.sold) { %>
      <div class="pd__rating">
        <% if (product.rating_count) { %>
        <span class="stars" aria-hidden="true"><% for (let i = 0; i < 5; i++) { %><svg class="i"><use href="#i-star"/></svg><% } %></span>
        <span><b><%= product.rating_avg %></b> (<%= product.rating_count %> đánh giá)</span>
        <% } %>
        <% if (product.sold) { %><span>Đã bán <b><%= product.sold %></b></span><% } %>
      </div>
      <% } %>

      <div class="pd__price">
        <strong class="price__now" data-price-now><%= contact ? 'Liên hệ báo giá' : vnd(product.finalPrice) %></strong>
        <s class="price__old" data-price-old <%= product.discount ? '' : 'hidden' %>><%= vnd(product.price) %></s>
        <span class="pd__save" data-price-save <%= product.discount ? '' : 'hidden' %>></span>
      </div>
      <% if (product.gift) { %>
      <div class="pd__gift">
        <svg class="i" aria-hidden="true"><use href="#i-gift"/></svg>
        <div>
          <b>Quà tặng kèm</b>
          <p><%= product.gift %></p>
        </div>
      </div>
      <% } %>

      <div class="pd__deal">
        <div class="pd__deal-head">
          <span class="pd__deal-ico"><svg class="i" aria-hidden="true"><use href="#i-phone"/></svg></span>
          <b><%= product.discount ? 'Liên hệ để có thêm ưu đãi' : 'Liên hệ để có giá tốt nhất' %></b>
        </div>
        <div class="pd__deal-btns">
          <a class="pd__deal-call" href="tel:<%= tel(s.hotline) %>"><svg class="i" aria-hidden="true"><use href="#i-phone"/></svg><%= s.hotline %></a>
          <% if (s.hotline2) { %><a class="pd__deal-call" href="tel:<%= tel(s.hotline2) %>"><svg class="i" aria-hidden="true"><use href="#i-phone"/></svg><%= s.hotline2 %></a><% } %>
          <a class="pd__deal-zalo" href="https://zalo.me/<%= tel(s.zalo) %>" target="_blank" rel="noopener"><span class="zalo-dot">Zalo</span>Zalo</a>
        </div>
      </div>


      <% if (grouped) { %>
      <fieldset class="pd__opt" style="border:0;padding:0;margin-top:22px">
        <legend class="pd__opt-h" style="width:100%;display:flex">Độ dày&nbsp;<span data-thick-label><%= defThick %> cm</span></legend>
        <div class="sizes">
          <% thicks.forEach(t => { const from = Math.min(...product.sizes.filter(s => +s.label.match(RE)[3] === t).map(fpOf)); %>
            <label class="size"><input type="radio" name="thick" value="<%= t %>" <%= t === defThick ? 'checked' : '' %>><span><%= t %> cm<small>từ <%= vnd(from) %></small></span></label>
          <% }) %>
        </div>
      </fieldset>
      <fieldset class="pd__opt" style="border:0;padding:0;margin-top:18px">
        <legend class="pd__opt-h" style="width:100%;display:flex">Kích thước&nbsp;<span data-dim-label></span></legend>
        <div class="sizes" data-dims>
          <% product.sizes.forEach(sz => { const m = sz.label.match(RE); %>
            <label class="size" data-thick="<%= m[3] %>" <%= +m[3] === defThick ? '' : 'hidden' %>><input type="radio" name="size" value="<%= sz.label %>" <%= sz.label === defSize.label ? 'checked' : '' %>><span><%= m[1] %> x <%= m[2] %><small><%= vnd(fpOf(sz)) %></small></span></label>
          <% }) %>
        </div>
      </fieldset>
      <% } else if (product.sizes.length) { %>
      <fieldset class="pd__opt" style="border:0;padding:0;margin-top:22px">
        <legend class="pd__opt-h" style="width:100%;display:flex">Kích thước&nbsp;<span data-size-label><%= defSize.label %></span></legend>
        <div class="sizes">
          <% product.sizes.forEach(sz => { const fp = sz.sale_price > 0 && sz.sale_price < sz.price ? sz.sale_price : sz.price; %>
            <label class="size"><input type="radio" name="size" value="<%= sz.label %>" <%= sz.label === defSize.label ? 'checked' : '' %>><span><%= sz.label %><small><%= vnd(fp) %></small></span></label>
          <% }) %>
        </div>
      </fieldset>
      <% } %>

      <% if (product.firmness) { %>
      <div class="pd__opt">
        <div class="pd__opt-h">Độ cứng <span><%= ['', 'Mềm', 'Mềm vừa', 'Vừa', 'Cứng vừa', 'Cứng'][product.firmness] %></span></div>
        <div class="firm-meter" aria-hidden="true"><% for (let i = 1; i <= 5; i++) { %><i class="<%= i <= product.firmness ? 'on' : '' %>"></i><% } %></div>
      </div>
      <% } %>

      <p class="pd__short" style="margin-top:16px"><%= product.short_desc %></p>

      <% if (contact) { %>
      <div class="pd__buy">
        <a class="btn btn--gold btn--lg" href="tel:<%= tel(s.hotline) %>"><svg class="i"><use href="#i-phone"/></svg>Gọi báo giá <%= s.hotline %></a>
        <a class="btn btn--navy btn--lg" href="/lien-he">Gửi yêu cầu báo giá</a>
      </div>
      <% } else { %>
      <div class="pd__buy">
        <div class="qty">
          <button type="button" data-qty-step="-1" aria-label="Giảm số lượng"><svg class="i"><use href="#i-minus"/></svg></button>
          <input type="number" value="1" min="1" max="99" data-qty aria-label="Số lượng">
          <button type="button" data-qty-step="1" aria-label="Tăng số lượng"><svg class="i"><use href="#i-plus"/></svg></button>
        </div>
        <button class="btn btn--gold btn--lg" type="button" data-pd-add="buy">Mua ngay</button>
        <button class="btn btn--navy btn--lg" type="button" data-pd-add="cart"><svg class="i"><use href="#i-cart"/></svg>Thêm vào giỏ</button>
      </div>
      <% } %>
      <div class="pd__consult">
        <a class="pd__consult-call" href="tel:<%= tel(s.hotline) %>"><svg class="i"><use href="#i-phone"/></svg><span><em>Gọi </em><b><%= s.hotline %></b></span></a>
        <a class="pd__consult-zalo" href="https://zalo.me/<%= tel(s.zalo) %>" target="_blank" rel="noopener"><span class="zalo-dot">Zalo</span>Tư vấn qua Zalo</a>
      </div>

      <ul class="perks">
        <li><svg class="i"><use href="#i-truck"/></svg><span><b>Giao &amp; lắp miễn phí</b><small>Nội thành trong ngày</small></span></li>
        <li><svg class="i"><use href="#i-shield"/></svg><span><b>Bảo hành <%= product.warranty || 'chính hãng' %></b><small>Chính hãng nhà sản xuất</small></span></li>
        <li><svg class="i"><use href="#i-gift"/></svg><span><b>Bộ quà tặng cao cấp</b><small>Kèm theo đệm</small></span></li>
        <li><svg class="i"><use href="#i-card"/></svg><span><b>Trả góp 0%</b><small>Duyệt nhanh qua thẻ</small></span></li>
      </ul>
    </div>
  </div>

  <section class="pd-tabs">
    <div class="pd-tabs__nav" role="tablist">
      <button class="is-active" role="tab" aria-selected="true" data-pd-tab="desc">Mô tả sản phẩm</button>
      <button role="tab" aria-selected="false" data-pd-tab="spec">Thông số kỹ thuật</button>
      <button role="tab" aria-selected="false" data-pd-tab="policy">Giao hàng &amp; đổi trả</button>
    </div>
    <div class="pd-tabs__panel prose" data-pd-panel="desc"><%- product.description %></div>
    <div class="pd-tabs__panel" data-pd-panel="spec" hidden>
      <table class="spec-table"><tbody>
        <% product.specs.forEach(r => { %><tr><th scope="row"><%= r[0] %></th><td><%= r[1] %></td></tr><% }) %>
        <% if (product.sizes.length) { %><tr><th scope="row">Kích thước</th><td><%= product.sizes.map(x => x.label).join(' · ') %></td></tr><% } %>
      </tbody></table>
    </div>
    <div class="pd-tabs__panel prose" data-pd-panel="policy" hidden>
      <h3>Giao hàng</h3><p>Miễn phí giao và lắp đặt trong bán kính 20km. Đơn đặt trước 15h được giao ngay trong ngày.</p>
      <h3>Đổi trả</h3><p>Đổi trả theo chính sách của hãng. Liên hệ hotline để được hỗ trợ. <a href="/chinh-sach/doi-tra">Xem chi tiết</a></p>
    </div>
  </section>

  <section class="rv" id="danh-gia" aria-labelledby="rv-title">
    <div class="rv__head">
      <div>
        <span class="eyebrow">Đánh giá sản phẩm</span>
        <h2 class="section__title" id="rv-title">Khách hàng nói gì về sản phẩm này</h2>
      </div>
      <% if (product.rating_count) { %>
        <div class="rv__score"><b><%= product.rating_avg %></b><span class="rv__stars" aria-label="<%= product.rating_avg %> trên 5 sao"><% for (let i = 1; i <= 5; i++) { %><svg class="i<%= i <= Math.round(product.rating_avg) ? ' on' : '' %>"><use href="#i-star"/></svg><% } %></span><small><%= product.rating_count %> đánh giá</small></div>
      <% } %>
    </div>
    <div class="rv__grid">
      <div class="rv__list">
        <% if (!productReviews.length) { %><p class="rv__empty">Chưa có đánh giá nào. Hãy là người đầu tiên chia sẻ trải nghiệm về sản phẩm này!</p><% } %>
        <% productReviews.forEach(r => { %>
          <article class="rv__item">
            <div class="rv__who"><span class="avatar"><%= (r.name.trim().split(' ').pop() || 'K')[0].toUpperCase() %></span><b><%= r.name %></b><small><%= String(r.created_at).slice(0, 10).split('-').reverse().join('/') %></small></div>
            <span class="rv__stars" aria-label="<%= r.rating %> sao"><% for (let i = 1; i <= 5; i++) { %><svg class="i<%= i <= r.rating ? ' on' : '' %>"><use href="#i-star"/></svg><% } %></span>
            <p><%= r.content %></p>
          </article>
        <% }) %>
      </div>
      <form class="rv__form card" method="post" action="/danh-gia">
        <h3>Viết đánh giá của bạn</h3>
        <% if (reviewed) { %><p class="rv__ok" role="status"><svg class="i"><use href="#i-check"/></svg>Cảm ơn bạn! Đánh giá sẽ hiển thị sau khi cửa hàng duyệt.</p><% } %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <div class="rv__pick" role="radiogroup" aria-label="Số sao">
          <% for (let i = 5; i >= 1; i--) { %><input type="radio" id="rv-s<%= i %>" name="rating" value="<%= i %>"<%= i === 5 ? ' checked' : '' %>><label for="rv-s<%= i %>" title="<%= i %> sao"><svg class="i"><use href="#i-star"/></svg></label><% } %>
        </div>
        <label class="sr-only" for="rv-name">Họ tên</label>
        <input class="rv__in" id="rv-name" name="name" placeholder="Họ tên *" required maxlength="80" autocomplete="name">
        <label class="sr-only" for="rv-phone">Số điện thoại</label>
        <input class="rv__in" id="rv-phone" name="phone" placeholder="Số điện thoại (không hiển thị công khai)" inputmode="tel" maxlength="15" autocomplete="tel">
        <label class="sr-only" for="rv-content">Nội dung</label>
        <textarea class="rv__in" id="rv-content" name="content" rows="4" placeholder="Cảm nhận của bạn về sản phẩm *" required minlength="5" maxlength="1500"></textarea>
        <input class="sr-only" tabindex="-1" autocomplete="off" name="website" aria-hidden="true">
        <button class="btn btn--gold" type="submit">Gửi đánh giá</button>
      </form>
    </div>
  </section>

  <% if (related.length) { %>
  <section style="padding-bottom:64px">
    <div class="section__head"><div><span class="eyebrow">Có thể bạn thích</span><h2 class="section__title">Sản phẩm tương tự</h2></div></div>
    <div class="rail" data-rail>
      <button class="rail__nav rail__nav--prev" type="button" data-rail-prev aria-label="Trước"><svg class="i"><use href="#i-chev-l"/></svg></button>
      <div class="rail__track"><% related.forEach(p => { %><%- include('../partials/product-card', { p }) %><% }) %></div>
      <button class="rail__nav rail__nav--next" type="button" data-rail-next aria-label="Sau"><svg class="i"><use href="#i-chev-r"/></svg></button>
    </div>
  </section>
  <% } %>
</main>

<div class="sticky-buy" aria-hidden="true">
  <div><small style="display:block;font-size:12px;color:var(--muted)">Giá</small><strong class="price__now" data-sticky-price><%= contact ? 'Liên hệ báo giá' : vnd(product.finalPrice) %></strong></div>
  <% if (contact) { %><a class="btn btn--gold" href="tel:<%= tel(s.hotline) %>" tabindex="-1">Gọi báo giá</a><% } else { %><button class="btn btn--gold" type="button" data-sticky-add tabindex="-1">Mua ngay</button><% } %>
</div>

<script type="application/json" id="product-data"><%- JSON.stringify({ id: product.id, price: Number(product.price), sale_price: Number(product.sale_price), sizes: product.sizes }).replace(/</g, '\\u003c') %></script>
<% if (!contact || product.rating_count) { %><script type="application/ld+json"><%- JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Product', name: product.name, image: product.images.map(i => siteUrl + i), description: product.short_desc, sku: product.sku,
  brand: { '@type': 'Brand', name: product.brand },
  aggregateRating: product.rating_count ? { '@type': 'AggregateRating', ratingValue: product.rating_avg, reviewCount: product.rating_count } : undefined,
  offers: contact ? undefined : { '@type': 'Offer', priceCurrency: 'VND', price: product.finalPrice, availability: product.in_stock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock', url: siteUrl + path }
}).replace(/</g, '\\u003c') %></script><% } %>
<% if (s.fb_pixel) { %><script>window.fbq && fbq('track', 'ViewContent', <%- JSON.stringify(Object.assign({ content_ids: [String(product.id)], content_type: 'product', content_name: product.name, content_category: cat ? cat.name : '' }, contact ? {} : { value: product.finalPrice, currency: 'VND' })).replace(/</g, '\\u003c') %>);</script><% } %>
<%- include('../partials/footer') %>
